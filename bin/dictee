#!/bin/bash
# Dictée vocale française hors-ligne — faster-whisper + GPU NVIDIA.
#
#   dictee start   commence l'enregistrement
#   dictee stop    arrête, transcrit, et tape le texte dans la fenêtre active
#
# Le daemon garde le modèle résident : voir `dictee daemon`.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=dictation-env.sh
source "$SCRIPT_DIR/dictation-env.sh"

DAEMON_PY="$SCRIPT_DIR/dictation-daemon.py"
TRANSCRIBE="$SCRIPT_DIR/transcribe.py"

notify() { notify-send -i "${2:-audio-input-microphone}" "Dictée" "$1" 2>/dev/null; }

daemon_transcribe() {
    local wav_path="$1"
    if [ -S "$SOCKET" ]; then
        echo "$wav_path" | socat -t120 - UNIX-CONNECT:"$SOCKET" 2>/dev/null
    else
        # Daemon absent : chargement du modèle à chaque appel, nettement plus lent.
        "$VENV/bin/python" "$TRANSCRIBE" "$wav_path" 2>/dev/null
    fi
}

# Insère le texte dans la fenêtre active, par le presse-papiers.
#
# ydotool et non xdotool : sous Wayland, Mutter n'implémente pas
# zwp_virtual_keyboard_v1 (protocole wlroots), donc aucun outil passant par le
# compositeur ne fonctionne. ydotool écrit dans /dev/uinput, au niveau noyau,
# et traverse libinput comme un vrai clavier.
#
# Mais on ne peut pas utiliser `ydotool type` : il émet des codes touches bruts
# en supposant une disposition US, et son propre --help l'assume — « there's no
# way to know how many keyboard layouts are there in the world, we're using raw
# keycodes now ». Sur AZERTY, la frappe sort en charabia.
#
# D'où le collage : le texte passe par le presse-papiers et on n'émet qu'un
# raccourci. Ctrl, Shift et V occupent la même position physique en AZERTY et en
# QWERTY, donc les codes bruts y sont justes quelle que soit la disposition.
# Bénéfice secondaire : l'insertion est instantanée, là où la frappe caractère
# par caractère prenait plusieurs secondes sur un paragraphe.
#
# La combinaison est paramétrable parce qu'elle dépend de l'application cible :
# les terminaux (Ptyxis, GNOME Terminal…) collent avec Ctrl+Shift+V. Détecter la
# fenêtre focalisée n'est pas possible — GNOME refuse
# org.gnome.Shell.Introspect.GetWindows aux appelants non autorisés.
PASTE_KEYS="${DICTATION_PASTE_KEYS:-ctrl+v}"

paste_keycodes() {
    # 29 = LEFTCTRL, 42 = LEFTSHIFT, 47 = V  (linux/input-event-codes.h)
    case "$1" in
        ctrl+shift+v) echo "29:1 42:1 47:1 47:0 42:0 29:0" ;;
        ctrl+v)       echo "29:1 47:1 47:0 29:0" ;;
        *)
            echo "Combinaison inconnue : $1 (attendu ctrl+v ou ctrl+shift+v)" >&2
            echo "29:1 47:1 47:0 29:0"
            ;;
    esac
}

type_text() {
    local text="$1" previous=""

    if ! command -v wl-copy >/dev/null 2>&1; then
        notify "wl-clipboard n'est pas installé" dialog-warning
        return 1
    fi

    if ! pgrep -x ydotoold >/dev/null 2>&1; then
        printf '%s' "$text" | wl-copy
        notify "ydotoold arrêté — texte laissé dans le presse-papiers" dialog-warning
        return 1
    fi

    previous=$(wl-paste --no-newline 2>/dev/null || true)
    printf '%s' "$text" | wl-copy
    ydotool key $(paste_keycodes "$PASTE_KEYS")

    # Laisse l'application consommer le presse-papiers avant de le restaurer.
    # La restauration ne porte que sur du texte : un contenu non textuel
    # (image…) présent avant la dictée est perdu.
    sleep 0.3
    if [ -n "$previous" ]; then
        printf '%s' "$previous" | wl-copy
    fi
    return 0
}

case "${1:-start}" in
    start)
        if [ -f "$PIDFILE" ]; then
            echo "Dictée déjà active (PID $(cat "$PIDFILE"))" >&2
            exit 1
        fi
        rm -f "$WAVFILE"
        notify "Écoute en cours..."
        parecord --channels=1 --rate=16000 --format=s16le --file-format=wav "$WAVFILE" &
        echo $! > "$PIDFILE"
        ;;

    stop)
        if [ ! -f "$PIDFILE" ]; then
            echo "Aucune dictée en cours." >&2
            exit 1
        fi
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        sleep 0.1   # laisse parecord vider son tampon
        notify "Transcription..."

        TEXT=$(daemon_transcribe "$WAVFILE")
        if [ -n "$TEXT" ]; then
            type_text "$TEXT" && notify "OK"
        else
            notify "Rien détecté" dialog-warning
        fi
        rm -f "$WAVFILE"
        ;;

    toggle)
        # Un seul raccourci clavier plutôt que deux.
        if [ -f "$PIDFILE" ]; then exec "$0" stop; else exec "$0" start; fi
        ;;

    daemon)        "$VENV/bin/python" "$DAEMON_PY" ;;
    daemon-stop)   "$VENV/bin/python" "$DAEMON_PY" --stop ;;
    daemon-status) "$VENV/bin/python" "$DAEMON_PY" --status ;;

    *)
        cat <<EOF
Usage: dictee <commande>

  start           démarre l'enregistrement
  stop            arrête, transcrit et tape le texte
  toggle          bascule start/stop (pratique en raccourci unique)

  daemon          lance le daemon au premier plan
  daemon-stop     arrête le daemon
  daemon-status   indique si le daemon tourne

Modèle courant : $DICTATION_MODEL   (surcharge : DICTATION_MODEL=small dictee ...)
Vocabulaire    : $VOCAB_FILE
Collage        : $PASTE_KEYS   (DICTATION_PASTE_KEYS=ctrl+shift+v pour un terminal)
EOF
        ;;
esac
