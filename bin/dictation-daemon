#!/bin/bash
# Enveloppe du daemon : prépare l'environnement CUDA puis passe la main à Python.
#
# Existe pour que dictation-daemon.service n'ait à coder en dur ni la version de
# Python, ni les chemins des bibliothèques CUDA — c'est dictation-env.sh qui les
# résout, et lui seul.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=dictation-env.sh
source "$SCRIPT_DIR/dictation-env.sh"

exec "$VENV/bin/python" "$SCRIPT_DIR/dictation-daemon.py" "$@"
