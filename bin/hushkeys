#!/bin/bash
# Offline dictation — faster-whisper on an NVIDIA GPU.
#
#   hushkeys start   begin recording
#   hushkeys stop    stop, transcribe, paste the text into the focused window
#
# The daemon keeps the model resident: see `hushkeys daemon`.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=hushkeys-env.sh
source "$SCRIPT_DIR/hushkeys-env.sh"

DAEMON_PY="$SCRIPT_DIR/hushkeys-daemon.py"
TRANSCRIBE="$SCRIPT_DIR/transcribe.py"

INDICATOR="$SCRIPT_DIR/hushkeys-indicator"

# Notifications are transient (-e): they do not stay in the notification list,
# so a day of dictation no longer leaves a pile of "Listening..." behind. Only
# failures are kept (keep), since their text is what the user needs to read.
#
# Not --replace-id: updating a notification whose banner is mid-animation
# crashes GNOME Shell 50's message tray (TypeError in _showNotificationCompleted,
# this._notification is null), after which no banner shows again until the
# session is restarted.
notify() {
    local transient=-e
    [ "${3:-}" = keep ] && transient=""
    notify-send $transient -i "${2:-audio-input-microphone}" "hushkeys" "$1" 2>/dev/null
}

indicator_call() {
    gdbus call --session --dest org.hushkeys.Indicator \
        --object-path /org/hushkeys/Indicator \
        --method org.hushkeys.Indicator.SetState "$1" "$2" >/dev/null 2>&1
}

# Something hosts StatusNotifier items: the AppIndicator extension under GNOME,
# the panel itself under KDE. Without it the indicator has nowhere to appear.
indicator_hosted() {
    command -v python3 >/dev/null 2>&1 &&
    gdbus call --session --dest org.kde.StatusNotifierWatcher \
        --object-path /StatusNotifierWatcher \
        --method org.freedesktop.DBus.Properties.Get \
        org.kde.StatusNotifierWatcher IsStatusNotifierHostRegistered 2>/dev/null |
    grep -q true
}

# Show where the dictation stands: listening, transcribing, done, warning,
# error. A banner vanishes after a few seconds and says nothing about the
# current state, so the state lives in the top bar (hushkeys-indicator, spawned
# at "listening" and gone after "done"). Notifications remain the fallback when
# nothing hosts the indicator, and the vehicle for text worth reading.
#
#   indicate STATE TEXT [ICON] [keep]
#     STATE goes to the indicator; TEXT/ICON to a notification when either the
#     indicator is unavailable or the state is a warning or an error.
indicate() {
    local state="$1" text="$2" icon="${3:-audio-input-microphone}" keep="${4:-}"
    local shown=false

    if [ "${HUSHKEYS_INDICATOR:-1}" != 0 ]; then
        if indicator_call "$state" "$text"; then
            shown=true
        elif [ "$state" = listening ] && indicator_hosted; then
            # setsid -f: the indicator must outlive this process, which the
            # GNOME shortcut runner reaps as soon as `hushkeys start` returns.
            setsid -f python3 "$INDICATOR" "$state" "$text" </dev/null >/dev/null 2>&1
            # Registering takes ~100 ms; give it up to a second.
            for _ in $(seq 20); do
                sleep 0.05
                if indicator_call "$state" "$text"; then shown=true; break; fi
            done
        fi
    fi

    case "$state" in
        warning|error) notify "$text" "$icon" $keep ;;
        *) $shown || notify "$text" "$icon" ;;
    esac
}

# Answers whose first byte is \x01 report a failure rather than a transcription
# (see hushkeys-daemon.py). \x01 cannot occur in dictated text.
ERROR_PREFIX=$'\x01ERROR '

daemon_transcribe() {
    local wav_path="$1" err status
    err=$(mktemp)

    if [ -S "$SOCKET" ]; then
        # -t is how long socat waits for the answer once it has sent the path.
        # Transcription runs at roughly a third of real time on a small GPU, so
        # 120s used to cut off any dictation past ~6 minutes — and a cut-off
        # answer is empty, which the caller could only read as "nothing heard".
        # 900s keeps the cap well beyond any plausible dictation.
        echo "$wav_path" | socat -t900 - UNIX-CONNECT:"$SOCKET" 2>"$err"
    else
        # No daemon: the model is loaded on every call, which is far slower.
        "$VENV/bin/python" "$TRANSCRIBE" "$wav_path" 2>"$err"
    fi
    status=$?

    # A failure must not reach the caller as an empty answer, which would be
    # indistinguishable from silence.
    if [ "$status" -ne 0 ]; then
        printf '%s%s' "$ERROR_PREFIX" "$(tail -1 "$err")"
    fi
    rm -f "$err"
}

# Insert the text into the focused window, through the clipboard.
#
# ydotool and not xdotool: under Wayland, Mutter does not implement
# zwp_virtual_keyboard_v1 (a wlroots protocol), so no tool that goes through the
# compositor works. ydotool writes to /dev/uinput, at kernel level, and comes
# back through libinput like a real keyboard.
#
# But `ydotool type` is unusable: it emits raw keycodes assuming a US layout,
# as its own --help concedes — "there's no way to know how many keyboard layouts
# are there in the world, we're using raw keycodes now". On AZERTY, typing comes
# out as gibberish.
#
# Hence pasting: the text goes through the clipboard and only a shortcut is
# emitted. Ctrl, Shift and V sit at the same physical position on AZERTY and
# QWERTY, so their raw keycodes are correct on either layout. Welcome side
# effect: insertion is instant, where typing character by character took several
# seconds on a paragraph.
#
# The combination is configurable because it depends on the target application:
# terminals (Ptyxis, GNOME Terminal…) paste with Ctrl+Shift+V. Detecting the
# focused window is not possible — GNOME denies
# org.gnome.Shell.Introspect.GetWindows to unauthorised callers.
PASTE_KEYS="${HUSHKEYS_PASTE_KEYS:-ctrl+v}"

paste_keycodes() {
    # 29 = LEFTCTRL, 42 = LEFTSHIFT, 47 = V  (linux/input-event-codes.h)
    case "$1" in
        ctrl+shift+v) echo "29:1 42:1 47:1 47:0 42:0 29:0" ;;
        ctrl+v)       echo "29:1 47:1 47:0 29:0" ;;
        *)
            echo "Unknown combination: $1 (expected ctrl+v or ctrl+shift+v)" >&2
            echo "29:1 47:1 47:0 29:0"
            ;;
    esac
}

type_text() {
    local text="$1" previous=""

    if ! command -v wl-copy >/dev/null 2>&1; then
        indicate error "wl-clipboard is not installed" dialog-error keep
        return 1
    fi

    if ! pgrep -x ydotoold >/dev/null 2>&1; then
        printf '%s' "$text" | wl-copy
        indicate warning "ydotoold is not running — text left in the clipboard" dialog-warning keep
        return 1
    fi

    previous=$(wl-paste --no-newline 2>/dev/null || true)
    printf '%s' "$text" | wl-copy
    ydotool key $(paste_keycodes "$PASTE_KEYS")

    # Let the application consume the clipboard before restoring it. Only text
    # is restored: non-text content (an image…) present before the dictation
    # is lost.
    sleep 0.3
    if [ -n "$previous" ]; then
        printf '%s' "$previous" | wl-copy
    fi
    return 0
}

case "${1:-start}" in
    start)
        if [ -f "$PIDFILE" ]; then
            echo "Already recording (PID $(cat "$PIDFILE"))" >&2
            exit 1
        fi
        rm -f "$WAVFILE"
        indicate listening "Listening..."
        parecord --channels=1 --rate=16000 --format=s16le --file-format=wav "$WAVFILE" &
        echo $! > "$PIDFILE"
        ;;

    stop)
        if [ ! -f "$PIDFILE" ]; then
            echo "Not recording." >&2
            exit 1
        fi
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        sleep 0.1   # let parecord flush its buffer
        indicate transcribing "Transcribing..."

        TEXT=$(daemon_transcribe "$WAVFILE")
        case "$TEXT" in
            "$ERROR_PREFIX"*)
                # Transcription failed. Saying "nothing heard" here would send
                # the user looking at their microphone; the recording is kept so
                # the failure can be reproduced.
                REASON="${TEXT#"$ERROR_PREFIX"}"
                mv -f "$WAVFILE" "$FAILED_WAV"
                echo "Transcription failed: $REASON" >&2
                echo "Recording kept: $FAILED_WAV" >&2
                indicate error "Transcription failed — see journalctl --user -u hushkeys-daemon" dialog-error keep
                ;;
            "")
                indicate warning "Nothing heard" dialog-warning
                rm -f "$WAVFILE"
                ;;
            *)
                type_text "$TEXT" && indicate done "Done"
                rm -f "$WAVFILE"
                ;;
        esac
        ;;

    toggle)
        # One keyboard shortcut rather than two.
        if [ -f "$PIDFILE" ]; then exec "$0" stop; else exec "$0" start; fi
        ;;

    daemon)        "$VENV/bin/python" "$DAEMON_PY" ;;
    daemon-stop)   "$VENV/bin/python" "$DAEMON_PY" --stop ;;
    daemon-status) "$VENV/bin/python" "$DAEMON_PY" --status ;;

    *)
        cat <<EOF
Usage: hushkeys <command>

  start           begin recording
  stop            stop, transcribe and paste the text
  toggle          switch between start and stop (handy on a single shortcut)

  daemon          run the daemon in the foreground
  daemon-stop     stop the daemon
  daemon-status   report whether the daemon is running

Model      : $HUSHKEYS_MODEL   (override: HUSHKEYS_MODEL=small hushkeys ...)
Vocabulary : $VOCAB_FILE
Paste keys : $PASTE_KEYS   (HUSHKEYS_PASTE_KEYS=ctrl+shift+v for a terminal)
Indicator  : ${HUSHKEYS_INDICATOR:-1}   (HUSHKEYS_INDICATOR=0 for notifications only)
EOF
        ;;
esac
