[Unit]
Description=hushkeys dictation daemon (faster-whisper, resident model)
After=graphical-session.target

[Service]
Type=simple
# The repository path does not appear here: install.sh creates a
# ~/bin/hushkeys-daemon symlink, and the wrapper walks back to the repository
# through readlink. The unit therefore stays valid wherever the repository is
# cloned, and can be symlinked as is — a git pull updates the installation
# without reinstalling.
#
# No Python version and no CUDA paths either: hushkeys-env.sh resolves those.
ExecStart=%h/bin/hushkeys-daemon
ExecStop=%h/bin/hushkeys-daemon --stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
