[Unit]
Description=Reload nvidia_uvm after suspend to restore CUDA
After=nvidia-resume.service
Before=graphical-session.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c '/bin/fuser -k /dev/nvidia-uvm 2>/dev/null; sleep 1; /sbin/modprobe -r nvidia_uvm; sleep 1; /sbin/modprobe nvidia_uvm'

[Install]
WantedBy=systemd-suspend.service
WantedBy=systemd-hibernate.service
