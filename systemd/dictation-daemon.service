[Unit]
Description=Daemon de dictée (faster-whisper, modèle résident)
After=graphical-session.target

[Service]
Type=simple
# Le chemin du dépôt n'apparaît pas ici : install.sh pose un lien symbolique
# ~/bin/dictation-daemon, et l'enveloppe remonte au dépôt par readlink. Le unit
# reste donc valable quel que soit l'endroit où le dépôt est cloné, et peut être
# lié tel quel — un git pull met l'installation à jour sans réinstaller.
#
# Ni version de Python ni chemins CUDA non plus : dictation-env.sh les résout.
ExecStart=%h/bin/dictation-daemon
ExecStop=%h/bin/dictation-daemon --stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
